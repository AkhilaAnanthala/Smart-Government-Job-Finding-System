# Copy this file to ".env" and change the values.
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string

# 1 = development mode (shows detailed errors), 0 = off
FLASK_DEBUG=1

# Set to 1 only when serving over HTTPS
SESSION_COOKIE_SECURE=0

# Optional: custom database location (leave commented to use the default)
# DATABASE_PATH=database/portal.db

# Used only by create_admin.py if you want to pre-fill values (optional).
# Do NOT put a real password here in a file you share or upload.
# ADMIN_EMAIL=admin@example.com